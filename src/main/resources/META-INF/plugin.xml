<idea-plugin>
  <id>vavi.idea.plugin.maven</id>
  <name>Maven Latest Versions</name>
  <vendor email="namachapanda2005@gmail.com">Umjammer</vendor>
  <description>Shows up-to-date version list on pom.xml version tags (cmd+/) and highlights versions that have newer releases.</description>

  <idea-version since-build="261"/>

  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.xml</depends>
  <!-- vulnerable transitive dependencies need the dependency tree resolved by the maven support -->
  <depends optional="true" config-file="vavi-maven-vulnerability.xml">org.jetbrains.idea.maven</depends>

  <extensions defaultExtensionNs="com.intellij">
    <localInspection language="XML" shortName="MavenNewerVersion" displayName="Newer dependency version available"
                     groupName="Maven" enabledByDefault="true" level="WEAK WARNING"
                     implementationClass="vavi.idea.plugin.maven.ide.NewerVersionInspection"/>
    <postStartupActivity implementation="vavi.idea.plugin.maven.ide.PrewarmActivity"/>
    <notificationGroup id="vavi.maven" displayType="BALLOON"/>
  </extensions>

  <actions>
    <action id="vavi.maven.ShowVersions" class="vavi.idea.plugin.maven.ide.ShowVersionsAction"
            text="Show Latest Versions" description="Show the latest versions of the dependency at caret">
      <keyboard-shortcut keymap="$default" first-keystroke="control SLASH"/>
      <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta SLASH"/>
      <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta SLASH"/>
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
